{
  "name": "multi-tenant-project-management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=apps/api/.env apps/api/node_modules/tsx/dist/cli.mjs watch apps/api/src/server.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
