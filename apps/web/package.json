    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.5",
    "next-intl": "4.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
